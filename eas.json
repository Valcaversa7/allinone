{
  "cli": {
    "version": ">= 24.3.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "developmentClient": false
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-arm64": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "preview-arm32": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a"
      }
    }
  }
}
