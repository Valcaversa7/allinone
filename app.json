{
  "expo": {
    "name": "College Timetable",
    "slug": "college-timetable",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "Allow College Timetable to capture timetable photos for on-device class extraction."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow College Timetable to import timetable images from your library.",
          "cameraPermission": "Allow College Timetable to take timetable photos for class extraction."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "./plugins/with-small-android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valcaversa7.allinone",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow College Timetable to import timetable images from your library."
      }
    },
    "android": {
      "package": "com.valcaversa7.allinone",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro"
    },
    "jsEngine": "hermes"
  }
}
